{
	"name": "durable-chat-template",
	"description": "Chat with other users in real-time using Durable Objects and PartyKit.",
	"private": true,
	"cloudflare": {
		"label": "Durable Chat App",
		"products": [
			"Workers",
			"Durable Objects"
		],
		"categories": [],
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/4554c09f-835e-45bc-b0a2-7c86e374ca00/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/a4f0dac8-ca71-4001-ac95-4036c400ed00/preview",
		"publish": true
	},
	"dependencies": {
		"nanoid": "5.1.6",
		"partyserver": "0.1.0",
		"partysocket": "1.1.10",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-router": "^7.12.0"
	},
	"devDependencies": {
		"@types/chrome": "^0.0.287",
		"@types/react": "^19.2.8",
		"@types/react-dom": "^19.2.3",
		"esbuild": "0.27.2",
		"typescript": "5.9.3",
		"wrangler": "^4.59.1"
	},
	"scripts": {
		"cf-typegen": "wrangler types ./src/server/worker-configuration.d.ts",
		"check": "tsc --project src/client && tsc --project src/server && tsc --project src/extension && wrangler deploy --dry-run",
		"build:extension": "npm run build:extension:panel && npm run build:extension:content",
		"build:extension:panel": "esbuild src/extension/panel.tsx --bundle --format=esm --platform=browser --loader:.css=css --outdir=extension/dist && cp src/extension/panel.html extension/dist/",
		"build:extension:content": "esbuild src/extension/content.ts --bundle --format=iife --platform=browser --outfile=extension/dist/content.js && cp src/extension/content.css extension/dist/content.css",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev"
	}
}
